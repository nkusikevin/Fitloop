# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Default AI Provider (if users don't configure their own keys)
# Choose one: openai, anthropic, google
DEFAULT_AI_PROVIDER=openai

# Optional: Fallback API Keys (if users don't configure their own)
# Only set ONE of these based on your DEFAULT_AI_PROVIDER
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_API_KEY=your_google_api_key
